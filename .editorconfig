# Editor / formatter baseline for AltCover.
#
# This is the machine-readable companion to Settings.FSharpLint: FSharpLint
# understands naming and a handful of rewrite rules, but it cannot express
# whitespace, encoding or final-newline policy, and it is not run by the build
# (see the `Lint` target in Build/targets.fsx, which is disabled pending
# FSharpLint/F# version compatibility). `.editorconfig` is honoured by Visual
# Studio, VS Code, Rider and `dotnet format`, so the same rules apply to everyone
# without a build step.
#
# The values below describe the code that is already in the tree -- F# uses two
# space indentation, C# uses four -- so adopting this file produces no reformat
# churn in existing files.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{fs,fsx,fsproj}]
indent_size = 2

[*.cs]
indent_size = 4

[*.{csproj,props,targets,config,xml,resx,rules}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.{md}]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.sln]
indent_style = tab

# --- F# ------------------------------------------------------------------- #
# F# is whitespace sensitive: these must stay as they are or the code will not
# compile.
[*.fs]
indent_style = space
tab_width = 2

[*.fsx]
indent_style = space
tab_width = 2

# --- Shell scripts --------------------------------------------------------- #
[*.sh]
indent_size = 2

# --- Python (repository policy gate) -------------------------------------- #
[*.py]
indent_size = 4
max_line_length = 100

# --- Generated / vendored: not ours to format ----------------------------- #
[ThirdParty/**]
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset
end_of_line = unset

[_Generated/**]
generated_code = true

[{build.fsx,setup.fsx}]
# Build/build.fsx is generated by Build/setup.fsx and is git-ignored.
generated_code = true
