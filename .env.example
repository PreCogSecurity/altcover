# Copy to .env (`cp .env.example .env`) before running `docker compose up`.
# Everything here is optional: the defaults in docker-compose.yml are the values
# used when a variable is unset. Never commit a filled-in .env -- it is
# git-ignored and excluded from the Docker build context.

# --- Container identity ---------------------------------------------------- #
# UID/GID that the dev shell runs as. Set these to your own `id -u` / `id -g` on
# Linux so the bind-mounted working tree (/app) stays writable. Ignored on
# Windows and macOS with Docker Desktop, where the filesystem layer does not
# enforce POSIX ownership.
ALTCOVER_UID=1000
ALTCOVER_GID=1000

# --- .NET SDK behaviour ---------------------------------------------------- #
# Opt out of SDK telemetry: this is a shared CI-grade image, and usage data
# should not leave a contributor's machine.
DOTNET_CLI_TELEMETRY_OPTOUT=1
# Suppress the first-run banner and the "welcome" text so build logs stay
# greppable.
DOTNET_NOLOGO=1

# --- Optional build credentials -------------------------------------------- #
# Leave blank for local work. Supply them only in a real CI environment; the
# Coveralls upload performed by the FAKE `UnitTestWithAltCoverRunner` target is
# skipped when this is empty, and the release deploy step is skipped entirely.
COVERALLS_REPO_TOKEN=
# Read by Build/targets.fsx `SetVersion` to stamp the assembly version. Leave
# blank locally, where the version is derived from appveyor.yml and git.
APPVEYOR_BUILD_VERSION=
