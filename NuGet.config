<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    AltCover restores from nuget.org only.

    The three MyGet "F-*" feeds this repository used to trust were retired by
    their owner years ago, so they cannot serve a package today; leaving them
    enabled only widens the restore failure surface.  Beyond availability, every
    additional feed is an unreviewed supply-chain hop: a feed that answers for a
    package name we already take from nuget.org is the classic dependency
    confusion vector, and a hijacked feed is a remote code execution primitive
    for every build that restores from it.

    Build/verify-repo.py enforces this allow-list in CI.  To add a feed, add it
    here *disabled*, with a comment recording why it is needed, and update
    ALLOWED_NUGET_SOURCES in that script.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-core" value="https://dotnet.myget.org/F/dotnet-core/api/v3/index.json" />
    <add key="powershell-core" value="https://powershell.myget.org/F/powershell-core/api/v3/index.json" />
    <add key="AvaloniaCI" value="https://www.myget.org/F/avalonia-ci/api/v2" />
  </packageSources>

  <disabledPackageSources>
    <add key="dotnet-core" value="true" />
    <add key="powershell-core" value="true" />
    <add key="AvaloniaCI" value="true" />
  </disabledPackageSources>
</configuration>
