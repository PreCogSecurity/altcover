<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the Avalonia visualizer.

  nuget.org is the primary source. AvaloniaCI is a MyGet feed that was retired
  by its owner; it is retained here, enabled, for one reason only: the project
  pins Avalonia 0.6.2-build5768-beta, a CI build that was never published to
  nuget.org (nuget.org goes 0.6.1, then 0.7.0-build445-beta). The feed is very
  likely already dead, which means this project cannot restore today. That is a
  pre-existing condition, not one introduced here.

  TRACKED FOLLOW-UP: move Visualizer/AltCover.Avalonia.fsproj to an Avalonia
  version that is published on nuget.org (0.6.1 is the nearest; 0.7.0 the
  nearest with a comparable API surface), then delete the AvaloniaCI entry
  below and drop the matching exception in Build/verify-repo.py. That change
  needs a compile of Visualizer/*.fs against the newer Avalonia, so it is not
  something to do blind.

  Do not add further sources. Build/verify-repo.py enforces this file against an
  explicit allow-list.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="AvaloniaCI" value="https://www.myget.org/F/avalonia-ci/api/v2" />
  </packageSources>
</configuration>
